# Copy to .env for local development
ALLOWED_ORIGINS=http://localhost:8080
LOG_LEVEL=DEBUG
# Set a long random value in production; keep it stable across redeploys.
AUTH_SECRET=
# For Render, mount a persistent disk and set this to /var/data/bloom.db.
# Relative paths are resolved from the API process working directory.
BLOOM_DB_PATH=data/bloom.db
